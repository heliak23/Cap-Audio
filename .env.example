# ========================================================
# Configurações do CapAudio - Ditado por Voz com IA
# ========================================================

# Provedor de Transcrição:
# 'local' -> 100% OFFLINE (privacidade total, roda direto no seu PC via faster-whisper)
# 'auto'  -> Usa Groq se tiver chave, senão roda 100% local offline
# 'groq'  -> Whisper turbo ultrarrápido na nuvem (~200ms)
# 'openai'-> Whisper oficial OpenAI
STT_PROVIDER=local

# Tamanho do Modelo Whisper Local (para modo offline):
# 'tiny' (~75MB, mais rápido, levíssimo)
# 'base' (~145MB, recomendado, excelente acurácia em português)
# 'small' (~480MB, máxima acurácia)
LOCAL_MODEL_SIZE=base
LOCAL_DEVICE=cpu

# Chaves de API (Opcional - NÃO são necessárias no modo offline!)
GROQ_API_KEY=
OPENAI_API_KEY=

# Idioma do ditado (ex: pt-BR, en-US, es-ES)
LANGUAGE=pt-BR

# Tecla de Atalho:
# f8, f9, f10, scroll_lock, caps_lock
HOTKEY=f8

# Modo de Ativação:
# 'push_to_talk' -> Segura a tecla para falar, solta para colar
# 'toggle' -> Pressiona uma vez para falar, pressiona de novo para parar
MODE=push_to_talk

# Sons de feedback ao iniciar/parar gravação (true/false)
AUDIO_FEEDBACK=true

# Restaurar área de transferência após digitar (true/false)
RESTORE_CLIPBOARD=true

# Exibir barra flutuante na tela (true/false)
SHOW_HUD=true
